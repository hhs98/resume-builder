DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Local Ollama (default). Run: ollama serve && ollama pull qwen2.5:7b
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen2.5:7b"

# Or point to a LAN machine running Ollama:
# OLLAMA_BASE_URL="http://192.168.10.244:11434"

# PDF generation (optional)
# GOTENBERG_URL="https://demo.gotenberg.dev/forms/chromium/convert/url"
# RESUME_PREVIEW_BASE_URL="https://cv.jobmedia.com.bd"
