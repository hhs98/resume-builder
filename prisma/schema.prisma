generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Resume {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  templateId  String
  
  // Contact info
  givenName   String
  familyName  String
  profession  String
  city        String
  postalCode  String
  division    String
  phone       String
  email       String
  photoDataUrl String?
  
  summary     String?  @db.Text
  
  // Relations
  workHistory WorkHistory[]
  education   Education?
  skills      Skill[]
  languages   Language[]
  references  Reference[]
}

model WorkHistory {
  id               String   @id @default(cuid())
  resumeId         String
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  jobTitle         String
  employer         String
  location         String
  remote           Boolean  @default(false)
  startMonth       String
  startYear        String
  endMonth         String?
  endYear          String?
  currentJob       Boolean  @default(false)
  responsibilities String?  @db.Text
}

model Education {
  id                  String @id @default(cuid())
  resumeId            String @unique
  resume              Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  educationLevel      String
  institution         String
  institutionLocation String
  degree              String
  fieldOfStudy        String
  graduationMonth     String
  graduationYear      String
}

model Skill {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  name     String
  rating   Int    @default(0)
}

model Language {
  id       String @id @default(cuid())
  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  name     String
  rating   Int    @default(0)
}

model Reference {
  id           String @id @default(cuid())
  resumeId     String
  resume       Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  
  name         String
  designation  String
  organization String
  phone        String
  email        String
  address      String
}
